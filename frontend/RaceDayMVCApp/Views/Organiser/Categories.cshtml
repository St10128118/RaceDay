@model ManageCategoriesViewModel
@{
    ViewData["Title"] = "Manage categories";
}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div><p class="eyebrow mb-1">@Model.Event.Name</p><h1 class="h2 display-heading mb-0">Categories</h1></div>
    <a class="btn btn-primary" asp-action="CreateCategory" asp-route-eventId="@Model.Event.EventId">Add category</a>
</div>
<p><a asp-action="Index" class="small text-decoration-none">← Organiser dashboard</a></p>
@if (Model.Error is not null) { <div class="alert alert-warning" role="status">@Model.Error</div> }
<div class="surface-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Category</th><th>Distance</th><th>Age range</th><th></th></tr></thead>
            <tbody>
            @if (Model.Categories.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted py-4">No categories have been added.</td></tr>
            }
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td class="fw-semibold">@category.Name</td>
                    <td>@(category.DistanceKm.HasValue ? $"{category.DistanceKm:0.##} km" : "—")</td>
                    <td>@(category.MinAge.HasValue || category.MaxAge.HasValue ? $"{category.MinAge?.ToString() ?? "Any"}–{category.MaxAge?.ToString() ?? "Any"}" : "All ages")</td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-2">
                            <a class="btn btn-sm btn-outline-primary" asp-action="EditCategory" asp-route-eventId="@Model.Event.EventId" asp-route-categoryId="@category.CategoryId">Edit</a>
                            <form asp-action="DeleteCategory" asp-route-eventId="@Model.Event.EventId" asp-route-categoryId="@category.CategoryId" method="post" onsubmit="return confirm('Delete this category? Categories with enrolments cannot be deleted.');">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
