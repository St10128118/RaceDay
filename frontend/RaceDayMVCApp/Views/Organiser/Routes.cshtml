@model ManageRoutesViewModel
@{
    ViewData["Title"] = "Manage routes";
}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div><p class="eyebrow mb-1">@Model.Event.Name</p><h1 class="h2 display-heading mb-0">Routes</h1></div>
    <a class="btn btn-primary" asp-action="CreateRoute" asp-route-eventId="@Model.Event.EventId">Add route</a>
</div>
<p><a asp-action="Index" class="small text-decoration-none">← Organiser dashboard</a></p>
@if (Model.Error is not null) { <div class="alert alert-warning" role="status">@Model.Error</div> }
@if (Model.Routes.Count == 0)
{
    <div class="surface-card p-4 text-muted">No routes have been added to this event.</div>
}
else
{
    <div class="row g-3">
        @foreach (var route in Model.Routes)
        {
            <div class="col-md-6">
                <article class="surface-card p-4 h-100">
                    <h2 class="h5 fw-bold">@route.Name</h2>
                    <p class="event-meta">@route.DistanceKm.ToString("0.##") km · @(route.ElevationGainMeters.HasValue ? $"{route.ElevationGainMeters} m elevation gain" : "Elevation not listed")</p>
                    @if (route.GPXUrl is not null) { <p><a href="@route.GPXUrl" target="_blank" rel="noopener noreferrer">View GPX ↗</a></p> }
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-action="EditRoute" asp-route-eventId="@Model.Event.EventId" asp-route-routeId="@route.RouteId">Edit</a>
                        <form asp-action="DeleteRoute" asp-route-eventId="@Model.Event.EventId" asp-route-routeId="@route.RouteId" method="post" onsubmit="return confirm('Delete this route?');"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form>
                    </div>
                </article>
            </div>
        }
    </div>
}
