@model RouteEditorViewModel
@{
    ViewData["Title"] = Model.RouteId.HasValue ? "Edit route" : "Add route";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="surface-card p-4 p-md-5">
            <a asp-action="Routes" asp-route-eventId="@Model.EventId" class="small text-decoration-none">← Back to routes</a>
            <p class="eyebrow mt-4 mb-1">Course details</p>
            <h1 class="h2 display-heading mb-4">@(Model.RouteId.HasValue ? "Edit route" : "Add a route")</h1>
            <form asp-action="@(Model.RouteId.HasValue ? "EditRoute" : "CreateRoute")" asp-route-eventId="@Model.EventId" asp-route-routeId="@Model.RouteId" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="DistanceKm" class="form-label"></label><input asp-for="DistanceKm" class="form-control" /><span asp-validation-for="DistanceKm" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="ElevationGainMeters" class="form-label"></label><input asp-for="ElevationGainMeters" class="form-control" /><span asp-validation-for="ElevationGainMeters" class="text-danger small"></span></div>
                </div>
                <div class="mt-3"><label asp-for="GPXUrl" class="form-label"></label><input asp-for="GPXUrl" class="form-control" placeholder="https://…" /><span asp-validation-for="GPXUrl" class="text-danger small"></span></div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Routes" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
                    <button class="btn btn-primary" type="submit">Save route</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
