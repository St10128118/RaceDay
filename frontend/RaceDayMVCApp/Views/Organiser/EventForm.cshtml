@model EventEditorViewModel
@{
    ViewData["Title"] = Model.EventId.HasValue ? "Edit event" : "Create event";
    var provinces = new[] { "Eastern Cape", "Free State", "Gauteng", "KwaZulu-Natal", "Limpopo", "Mpumalanga", "North West", "Northern Cape", "Western Cape" };
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="surface-card p-4 p-md-5">
            <a asp-action="Index" class="small text-decoration-none">← Organiser dashboard</a>
            <p class="eyebrow mt-4 mb-1">Event setup</p>
            <h1 class="h2 display-heading mb-4">@(Model.EventId.HasValue ? "Edit event" : "Create an event")</h1>
            <form asp-action="@(Model.EventId.HasValue ? "EditEvent" : "CreateEvent")" asp-route-eventId="@Model.EventId" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EventType" class="form-label">Activity</label>
                        <select asp-for="EventType" class="form-select">
                            <option>Running</option><option>Walking</option><option>Cycling</option>
                        </select>
                        <span asp-validation-for="EventType" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EventDateTime" class="form-label"></label>
                        <input asp-for="EventDateTime" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EventDateTime" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DistanceKm" class="form-label"></label>
                        <div class="input-group"><input asp-for="DistanceKm" class="form-control" /><span class="input-group-text">km</span></div>
                        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MaxParticipants" class="form-label"></label>
                        <input asp-for="MaxParticipants" class="form-control" placeholder="No limit" />
                        <span asp-validation-for="MaxParticipants" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label">Venue / start location</label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Province" class="form-label"></label>
                        <select asp-for="Province" class="form-select">
                            <option value="">Choose province</option>
                            @foreach (var province in provinces)
                            {
                                <option value="@province">@province</option>
                            }
                        </select>
                        <span asp-validation-for="Province" class="text-danger small"></span>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button class="btn btn-primary" type="submit">@Model.SubmitLabel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
