@model RegisterViewModel
@{
    ViewData["Title"] = "Create an account";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="surface-card p-4 p-md-5">
            <p class="eyebrow mb-2">Join the start line</p>
            <h1 class="h2 display-heading mb-2">Create your account</h1>
            <p class="text-muted mb-4">Choose how you’ll use RaceDay. Organiser accounts can create events immediately.</p>
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Password" class="form-label">Password <span class="text-muted fw-normal">(at least 12 characters)</span></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label">I’m joining as</label>
                        <select asp-for="Role" class="form-select">
                            <option value="Participant">Participant</option>
                            <option value="Organiser">Event organiser</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="OrganisationName" class="form-label">Organisation <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="OrganisationName" class="form-control" autocomplete="organization" />
                        <span asp-validation-for="OrganisationName" class="text-danger small"></span>
                    </div>
                </div>
                <button class="btn btn-primary w-100 mt-4" type="submit">Create account</button>
            </form>
            <p class="text-muted mt-4 mb-0">Already registered? <a asp-action="Login">Sign in</a>.</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
