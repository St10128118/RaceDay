@model ProfileEditViewModel
@{
    ViewData["Title"] = "My profile";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="surface-card p-4 p-md-5">
            <p class="eyebrow mb-1">Your account</p>
            <h1 class="h2 display-heading">Profile</h1>
            <p class="text-muted mb-4">Keep your contact details current for race-day updates.</p>
            <form asp-action="Profile" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input asp-for="Email" type="hidden" />
                <input asp-for="Role" type="hidden" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input value="@Model.Email" class="form-control" readonly />
                        <div class="form-text">Email changes aren’t available in this release.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    @if (Model.Role == "Organiser")
                    {
                        <div class="col-md-6">
                            <label asp-for="OrganisationName" class="form-label"></label>
                            <input asp-for="OrganisationName" class="form-control" autocomplete="organization" />
                            <span asp-validation-for="OrganisationName" class="text-danger small"></span>
                        </div>
                    }
                    <div class="col-md-6">
                        <label asp-for="EmergencyContactName" class="form-label"></label>
                        <input asp-for="EmergencyContactName" class="form-control" />
                        <span asp-validation-for="EmergencyContactName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EmergencyContactPhone" class="form-label"></label>
                        <input asp-for="EmergencyContactPhone" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="EmergencyContactPhone" class="text-danger small"></span>
                    </div>
                </div>
                <div class="d-flex justify-content-end mt-4">
                    <button class="btn btn-primary" type="submit">Save profile</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
